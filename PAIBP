<script>
const stations=[
 {title:"Gerbang Anak Saleh",icon:"🚪",short:"Kenali misi",desc:"Hukum salat fardu",intro:"Assalamu’alaikum, Penjelajah! Rafi dan Aisyah mengajakmu belajar tentang salat fardu. Siap memulai misi?",type:"quiz"},
 {title:"Lembah Lima Waktu",icon:"🌅",short:"Kenali 5 salat",desc:"Waktu dan jumlah rakaat",intro:"Ayo bantu Rafi dan Aisyah mengenali lima salat fardu dan jumlah rakaatnya.",type:"prayer"},
 {title:"Mata Air Kesucian",icon:"💧",short:"Siapkan salat",desc:"Syarat salat",intro:"Sebelum salat, kita perlu mempersiapkan diri. Pilih sikap yang sesuai dengan materi buku.",type:"prep"},
 {title:"Istana Gerakan Salat",icon:"🕌",short:"Susun urutan",desc:"Rukun dan gerakan salat",intro:"Ayo kenali gerakan salat. Susun nomor urutan gerakan sesuai urutan yang dipelajari.",type:"order"},
 {title:"Taman Bintang",icon:"🌟",short:"Misi akhir",desc:"Evaluasi dan refleksi",intro:"Ini misi terakhir! Jawab pertanyaan, lalu renungkan kebiasaan salatmu.",type:"final"}
];
let completed=new Set(), xp=0, answered=new Set(), active=0;
const questions=[
 {q:"Hukum melaksanakan salat fardu bagi umat Islam adalah …",opts:["Sunah","Wajib","Mubah","Makruh"],a:1,why:"Dalam buku, salat fardu dijelaskan sebagai ibadah wajib bagi setiap Muslim."},
 {q:"Salat Subuh berjumlah … rakaat.",opts:["2 rakaat","3 rakaat","4 rakaat","5 rakaat"],a:0,why:"Salat Subuh dilaksanakan sebelum matahari terbit dan berjumlah 2 rakaat."},
 {q:"Salat yang dilaksanakan setelah matahari terbenam adalah …",opts:["Zuhur","Asar","Magrib","Subuh"],a:2,why:"Buku menyebutkan salat Magrib dilaksanakan setelah matahari terbenam."},
 {q:"Sebelum salat, ketika berhadas kita perlu …",opts:["Langsung salat","Berwudu","Meneruskan bermain","Membuka penutup aurat"],a:1,why:"Buku menjelaskan bahwa sebelum salat kita bersuci dari hadas dengan berwudu."},
 {q:"Gerakan membungkukkan badan dengan kedua tangan di lutut disebut …",opts:["Salam","Sujud","Rukuk","Iktidal"],a:2,why:"Rukuk adalah gerakan membungkukkan badan; lakukan dengan tenang."},
 {q:"Saat azan Zuhur terdengar ketika sedang bermain, sikap yang tepat adalah …",opts:["Mengabaikan azan","Mengajak teman bermain lebih lama","Bersiap untuk salat","Menunggu sampai malam"],a:2,why:"Buku mengajarkan agar kita segera bersiap dan tidak menunda-nunda ketika waktu salat tiba."},
 {q:"Jumlah seluruh rakaat salat fardu sehari semalam adalah …",opts:["15 rakaat","17 rakaat","18 rakaat","20 rakaat"],a:1,why:"Jumlahnya 2 + 4 + 4 + 3 + 4 = 17 rakaat."},
 {q:"Gerakan salat dilakukan secara berurutan dan tidak melompati gerakan. Sikap ini disebut …",opts:["Tertib","Terburu-buru","Bermain","Berhenti"],a:0,why:"Tertib berarti melakukan rukun salat secara berurutan."}
];
function renderMap(){
 const map=document.getElementById('map');map.innerHTML='';
 stations.forEach((s,i)=>{let b=document.createElement('button');b.className='station '+(completed.has(i)?'done ':'')+(i===active?'active ':'')+(i>0&&!completed.has(i-1)?'locked':'');b.innerHTML=`<span class="emoji">${s.icon}</span><b>${i+1}. ${s.title}</b><small>${s.desc}</small>${completed.has(i)?'<span class="check">✓</span>':''}`;b.onclick=()=>{if(i===0||completed.has(i-1)||completed.has(i)){showMission(i)}else{alert('Selesaikan pos sebelumnya terlebih dahulu, ya!')}};map.appendChild(b)});
 document.getElementById('xp').textContent=xp+' XP';document.getElementById('stars').textContent='★ '.repeat(completed.size)+'☆ '.repeat(5-completed.size);document.getElementById('progressText').textContent=completed.size+'/5';document.getElementById('progressBar').style.width=(completed.size*20)+'%';
}
function showMission(i){active=i;renderMap();document.getElementById('certificatePanel').classList.add('hidden');const p=document.getElementById('missionPanel');p.classList.remove('hidden');let s=stations[i];let html=`<div class="mission-head"><div class="mission-icon">${s.icon}</div><div><span class="tag">POS ${i+1} DARI 5</span><h2>${s.title}</h2><p>${s.intro}</p></div></div>`;
 if(i===0) html+=quizBlock(0,"Mulai petualangan");
 if(i===1) html+=prayerBlock();
 if(i===2) html+=prepBlock();
 if(i===3) html+=orderBlock();
 if(i===4) html+=quizBlock(1,"Selesaikan evaluasi");
 p.innerHTML=html;
 if(i===0) wireQuiz('q0',0,0);
 if(i===1) wirePrayer();
 if(i===2) wirePrep();
 if(i===3) wireOrder();
 if(i===4) wireQuiz('q1',1,4);
}
function quizBlock(final=false,label){let qs=final?questions.slice(3,8):questions.slice(0,1);return `<div class="activity"><p class="question">${final?'Evaluasi akhir: jawablah 5 pertanyaan berikut.':'Tantangan: '+qs[0].q}</p>${final?qs.map((q,j)=>`<div style="margin:18px 0"><p><strong>${j+1}. ${q.q}</strong></p><div class="choices">${q.opts.map((o,k)=>`<button class="choice" data-q="${j}" data-a="${k}">${String.fromCharCode(65+k)}. ${o}</button>`).join('')}</div><div class="feedback" id="fb${j}"></div></div>`).join(''):`<div class="choices">${qs[0].opts.map((o,k)=>`<button class="choice" data-q="0" data-a="${k}">${String.fromCharCode(65+k)}. ${o}</button>`).join('')}</div><div class="feedback" id="fb0"></div>`}<div class="row-actions"><button class="primary" id="finishQuiz" disabled>${label} →</button><button class="light" onclick="speak('${(final?'Ayo jawab evaluasi akhir dengan tenang.':'Pilih jawaban yang menurutmu benar.').replace(/'/g,"\\'")}')">🔊 Petunjuk suara</button></div></div>`}
function wireQuiz(id,final,station){
 let qs=final?questions.slice(3,8):questions.slice(0,1), answers={};
 document.querySelectorAll('.choice[data-q]').forEach(btn=>btn.onclick=()=>{
  let qi=+btn.dataset.q,ai=+btn.dataset.a,q=qs[qi];answers[qi]=ai;
  document.querySelectorAll(`.choice[data-q="${qi}"]`).forEach(x=>{x.classList.remove('correct','wrong');x.disabled=true});
  btn.classList.add(ai===q.a?'correct':'wrong');document.getElementById('fb'+qi).textContent=(ai===q.a?'Hebat! ':'Belum tepat. ')+q.why;
  if(Object.keys(answers).length===qs.length){let f=document.getElementById('finishQuiz');f.disabled=false;f.textContent='Lihat hasil dan lanjutkan →'}
 });
 document.getElementById('finishQuiz').onclick=()=>{let score=qs.reduce((n,q,j)=>n+(answers[j]===q.a?1:0),0);let gain=score*10;xp+=gain;complete(station);if(final){document.getElementById('certStars').textContent=completed.size+' bintang';document.getElementById('certXP').textContent=xp+' XP';document.getElementById('missionPanel').classList.add('hidden');document.getElementById('certificatePanel').classList.remove('hidden')}else showMission(1);renderMap();};
}
function prayerBlock(){let data=[['Subuh','2','Sebelum matahari terbit','🌄'],['Zuhur','4','Siang hari','☀️'],['Asar','4','Sore hari','🌤️'],['Magrib','3','Setelah matahari terbenam','🌇'],['Isya','4','Malam hari','🌙']];return `<div class="activity"><p class="question">Ketuk kartu untuk mendengar nama salat dan jumlah rakaatnya.</p><div class="cards">${data.map(d=>`<button class="prayer-card" data-prayer="${d[0]}"><span>${d[3]}</span><strong>${d[0]}</strong><span>${d[1]}</span><small>rakaat<br>${d[2]}</small></button>`).join('')}</div><p class="pill" style="margin-top:14px">Ingat: total 5 waktu = 17 rakaat.</p><div class="row-actions"><button class="primary" id="prayerDone">Saya siap ke pos berikutnya →</button></div></div>`}
function wirePrayer(){document.querySelectorAll('[data-prayer]').forEach(b=>b.onclick=()=>{let d=b.dataset.prayer;let item={Subuh:'2 rakaat, sebelum matahari terbit',Zuhur:'4 rakaat, siang hari',Asar:'4 rakaat, sore hari',Magrib:'3 rakaat, setelah matahari terbenam',Isya:'4 rakaat, malam hari'}[d];speak('Salat '+d+', '+item)});document.getElementById('prayerDone').onclick=()=>{xp+=20;complete(1);showMission(2)}}
function prepBlock(){let items=['Berwudu untuk bersuci dari hadas.','Menjaga badan dan pakaian suci dari najis.','Menutup aurat.','Menghadap kiblat.','Menjaga ketenangan dan tidak bermain-main saat salat.'];return `<div class="activity"><p class="question">Pilih semua persiapan atau sikap yang sesuai dengan materi.</p><div class="checklist">${items.map((t,i)=>`<label class="checkline"><input type="checkbox" value="${i}"><span>${t}</span></label>`).join('')}</div><div class="feedback" id="prepFeedback"></div><div class="row-actions"><button class="primary" id="prepCheck">Periksa pilihan</button><button class="light" onclick="speak('Sebelum salat, perhatikan kesucian, aurat, arah kiblat, dan lakukan salat dengan tertib.')">🔊 Dengarkan petunjuk</button></div></div>`}
function wirePrep(){document.getElementById('prepCheck').onclick=()=>{let n=document.querySelectorAll('.checkline input:checked').length;let f=document.getElementById('prepFeedback');if(n===5){f.textContent='Bagus! Kamu mengenali semua persiapan dan sikap yang dipelajari.';xp+=20;complete(2);setTimeout(()=>showMission(3),850)}else f.textContent='Coba periksa kembali. Dalam materi ini ada lima persiapan dan sikap yang perlu kamu kenali.'}}
const moves=['Niat dan takbiratul ihram','Berdiri tegak dan membaca Al-Fatihah','Rukuk dengan tumakninah','Iktidal','Sujud dua kali dengan tumakninah','Duduk di antara dua sujud','Duduk tasyahud akhir dan membaca selawat','Salam serta tertib'];
function orderBlock(){return `<div class="activity"><p class="question">Pilih nomor urutan untuk setiap gerakan. Gunakan urutan 1 sampai 8.</p><div class="order-list">${moves.map((m,i)=>`<label class="order-item"><span>${m}</span><select aria-label="Urutan ${m}" data-move="${i}"><option value="">Pilih</option>${moves.map((_,j)=>`<option value="${j+1}">${j+1}</option>`).join('')}</select></label>`).join('')}</div><div class="feedback" id="orderFeedback"></div><div class="row-actions"><button class="primary" id="orderCheck">Periksa urutan</button><button class="light" onclick="speak('Lakukan gerakan salat dengan tertib dan tumakninah, artinya tenang.')">🔊 Dengarkan petunjuk</button></div><p class="note">Catatan: daftar ini merangkum urutan gerakan dan rukun yang dicantumkan dalam PDF. Praktikkan bersama guru untuk mempelajari bacaan dan gerakannya dengan benar.</p></div>`}
function wireOrder(){document.getElementById('orderCheck').onclick=()=>{let sels=[...document.querySelectorAll('[data-move]')];let vals=sels.map(s=>s.value);let good=vals.every((v,i)=>v===String(i+1))&&new Set(vals).size===8;let f=document.getElementById('orderFeedback');if(good){f.textContent='Masyaallah, urutanmu benar! Ingat untuk salat dengan tenang (tumakninah).';xp+=30;complete(3);setTimeout(()=>showMission(4),900)}else f.textContent='Belum tepat. Susun sesuai daftar urutan dari awal sampai akhir. Pastikan setiap nomor dipakai satu kali.'}}
function complete(i){completed.add(i);renderMap();if(completed.size===5){document.getElementById('certStars').textContent=completed.size+' bintang';document.getElementById('certXP').textContent=xp+' XP'}}
function speak(text){if(!('speechSynthesis'in window)){alert('Audio narasi tidak didukung browser ini. Silakan baca petunjuk pada layar.');return}window.speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(text);u.lang='id-ID';u.rate=.92;u.pitch=1;u.volume=.85;window.speechSynthesis.speak(u)}
renderMap();showMission(0);
</script>
</body></html>'''
path = Path("/mnt/data/petualangan_cahaya_salat_kelas2.html")
path.write_text(html, encoding="utf-8")
